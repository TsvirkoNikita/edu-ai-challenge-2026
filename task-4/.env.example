# Runways: JSON array. Each runway has id, length (meters), ops ("arrival"|"departure"|"both").
ATC_RUNWAYS=[{"id":"09L","length":3500,"ops":"both"},{"id":"09R","length":2400,"ops":"both"}]

# Resource counts
ATC_GATE_COUNT=4
ATC_GROUND_CREW_COUNT=3

# Runway separation buffers (seconds) on the same runway
ATC_SEPARATION_TAKEOFF_SEC=90
ATC_SEPARATION_LANDING_SEC=120
ATC_SEPARATION_MIXED_SEC=150

# Gate turnaround between an arrival and the next departure at the same gate (seconds)
ATC_GATE_TURNAROUND_SEC=1800

# Minimum gap after a dependency completes before a dependent flight may start (seconds)
ATC_DEPENDENCY_BUFFER_SEC=600

# Maximum scheduling horizon (seconds) measured from epoch
ATC_SCHEDULING_HORIZON_SEC=86400

# Default operation durations (seconds)
ATC_ARRIVAL_DURATION_SEC=300
ATC_DEPARTURE_DURATION_SEC=240

# Deterministic schedule anchor; default 1970-01-01T00:00:00Z
ATC_EPOCH_ISO=2026-05-18T06:00:00Z
