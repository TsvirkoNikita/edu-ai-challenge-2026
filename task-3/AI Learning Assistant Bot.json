      "id": "9fb7b3f1-8456-4ea3-823c-e7cb85b23ef6",
      "name": "Get User Materials",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        11040,
        9120
      ]
    },
    {
      "parameters": {
        "jsCode": "const materials = $input.all().map(item => item.json);\nconst chatId = $(\"Telegram Bot\").item.json.message.chat.id;\n\nif (materials.length === 0) {\n  return [{ json: { \n    chatId,\n    text: 'You have no saved materials yet. Use /learn [URL] to add some!',\n    hasKeyboard: false\n  } }];\n}\n\nconst rows = materials.map(m => ({\n  row: {\n    buttons: [{\n      text: m.title || m.url || 'Untitled Material',\n      additionalFields: {\n        callback_data: 'quiz_' + m.materialId\n      }\n    }]\n  }\n}));\n\nreturn [{ json: { \n  chatId,\n  text: 'Select a topic to quiz yourself on:',\n  hasKeyboard: true,\n  keyboardRows: rows\n} }];"
      },
      "id": "01e49ec1-3f51-4b0d-bdbe-31382678b1e0",
      "name": "Format Materials List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        11264,
        9120
      ]
    },
    {
      "parameters": {
        "jsCode": "const callback = $input.first().json.callback_query;\nconst data = callback.data;\n\nif (data.startsWith('quiz_')) {\n  const materialId = data.replace('quiz_', '');\n  return [{ json: { \n    type: 'quiz_start',\n    materialId,\n    chatId: callback.message.chat.id,\n    queryId: callback.id\n  } }];\n}\n\nif (data.startsWith('answer_')) {\n  const parts = data.split('_');\n  return [{ json: { \n    type: 'answer',\n    questionIndex: parseInt(parts[1]),\n    answer: parts[2],\n    chatId: callback.message.chat.id,\n    queryId: callback.id\n  } }];\n}\n\nreturn [{ json: { type: 'unknown' } }];"
      },
