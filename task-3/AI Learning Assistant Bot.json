      "credentials": {
        "telegramApi": {
          "id": "4pGTSLqqNdw3lMZi",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.text;\nconst urlMatch = text.match(/\\/learn\\s+(https?:\\/\\/[^\\s]+)/);\nif (!urlMatch) {\n  return [{ json: { \n    error: true,\n    chatId: $input.first().json.message.chat.id\n  } }];\n}\nreturn [{ json: { \n  error: false,\n  url: urlMatch[1],\n  chatId: $input.first().json.message.chat.id,\n  userId: $input.first().json.message.from.id\n} }];"
      },
