      "id": "ce1692fc-a0ef-42ea-bfa2-83a5d8e53128",
      "name": "Route Quiz Flow",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        12288,
        10064
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $(\"Process Answer\").item.json;\nconst answers = JSON.parse(data.answers);\nconst questions = data.questions;\n\nconst correct = answers.filter(a => a.isCorrect).length;\nconst total = answers.length;\nconst percentage = Math.round((correct / total) * 100);\n\nlet resultText = '🎉 Quiz Complete!\\n\\n';\nresultText += '📊 Score: ' + correct + '/' + total + ' (' + percentage + '%)\\n\\n';\nresultText += '<b>Results:</b>\\n';\n\nanswers.forEach((a, idx) => {\n  const q = questions[a.questionIndex];\n  const icon = a.isCorrect ? '✅' : '❌';\n  resultText += icon + ' Q' + (idx + 1) + ': ' + q.question + '\\n';\n  if (!a.isCorrect) {\n    resultText += '   Your answer: ' + a.userAnswer + '\\n';\n    resultText += '   Correct: ' + a.correctAnswer + '\\n';\n    resultText += '   ' + q.explanation + '\\n';\n  }\n  resultText += '\\n';\n});\n\nresultText += 'Want to learn more? Use /learn [URL] to add new materials!';\n\nreturn [{ json: { \n  chatId: data.chatId,\n  queryId: data.queryId,\n  text: resultText,\n  score: percentage\n} }];"
      },
