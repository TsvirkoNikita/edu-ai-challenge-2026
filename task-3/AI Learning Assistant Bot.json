    {
      "parameters": {
        "jsCode": "const quiz = $(\"Save Quiz\").item.json;\nconst questions = typeof quiz.questions === 'string' ? JSON.parse(quiz.questions) : quiz.questions;\nconst currentQ = questions[0];\n\nconst buttons = currentQ.options.map((opt, idx) => ({\n  text: opt,\n  callback_data: 'answer_0_' + String.fromCharCode(65 + idx)\n}));\n\nreturn [{ json: { \n  chatId: $(\"Parse Callback\").item.json.chatId,\n  queryId: $(\"Parse Callback\").item.json.queryId,\n  text: '📝 Question 1 of ' + questions.length + '\\n\\n' + currentQ.question,\n  buttons\n} }];"
      },
