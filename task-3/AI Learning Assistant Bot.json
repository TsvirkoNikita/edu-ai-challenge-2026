    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=Welcome to your AI Learning Assistant! 🎓\n\nCommands:\n/learn [URL] - Submit a learning material\n/quiz - Take a quiz on saved materials\n\nStart by sharing a URL to learn from!",
        "additionalFields": {}
      },
