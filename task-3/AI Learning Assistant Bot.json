    {
      "parameters": {
        "jsCode": "const callback = $(\"Parse Callback\").item.json;\nconst quiz = $input.first().json;\nconst questions = JSON.parse(quiz.questions);\nconst answers = JSON.parse(quiz.answers);\n\nconst questionIndex = callback.questionIndex;\nconst userAnswer = callback.answer;\nconst question = questions[questionIndex];\n\nanswers.push({\n  questionIndex,\n  userAnswer,\n  correctAnswer: question.correctAnswer,\n  isCorrect: userAnswer === question.correctAnswer\n});\n\nconst nextIndex = questionIndex + 1;\nconst isComplete = nextIndex >= questions.length;\n\nreturn [{ json: { \n  quizId: quiz.id,\n  answers: JSON.stringify(answers),\n  currentQuestion: nextIndex,\n  completed: isComplete,\n  chatId: callback.chatId,\n  queryId: callback.queryId,\n  questions,\n  lastQuestion: question,\n  userAnswer,\n  nextIndex,\n  isComplete\n} }];"
      },
      "id": "7862b013-68ac-49fe-b2ee-793ff16b5301",
      "name": "Process Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
