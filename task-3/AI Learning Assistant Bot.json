    {
      "parameters": {
        "jsCode": "const data = $(\"Process Answer\").item.json;\nconst questions = data.questions;\nconst nextQ = questions[data.nextIndex];\n\nconst buttons = nextQ.options.map((opt, idx) => ({\n  text: opt,\n  callback_data: 'answer_' + data.nextIndex + '_' + String.fromCharCode(65 + idx)\n}));\n\nconst feedback = data.userAnswer === data.lastQuestion.correctAnswer \n  ? '✅ Correct!' \n  : '❌ Incorrect. ' + data.lastQuestion.explanation;\n\nreturn [{ json: { \n  chatId: data.chatId,\n  queryId: data.queryId,\n  feedbackText: feedback,\n  questionText: '📝 Question ' + (data.nextIndex + 1) + ' of ' + questions.length + '\\n\\n' + nextQ.question,\n  buttons\n} }];"
      },
